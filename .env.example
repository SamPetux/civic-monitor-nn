# === VK ===
VK_TOKEN=ваш_токен_здесь

# === База данных (выберите один вариант) ===

# Вариант 1 — PostgreSQL (продакшн, рекомендуется)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/civic_monitor

# Вариант 2 — отдельные переменные (альтернатива варианту 1)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=civic_monitor
# POSTGRES_USER=civic_user
# POSTGRES_PASSWORD=секретный_пароль

# Если ни одно из выше не задано — автоматически используется SQLite (data/posts.db)