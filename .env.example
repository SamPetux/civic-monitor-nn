# ============================================================
# Скопируй в .env и заполни своими значениями:
#   cp .env.example .env
# ============================================================

# --- VK API ---
VK_TOKEN=your_vk_token_here

# --- PostgreSQL ---
POSTGRES_HOST=localhost       # для локального запуска без Docker
POSTGRES_PORT=5432
POSTGRES_DB=civic_monitor
POSTGRES_USER=civic_user
POSTGRES_PASSWORD=localpass123

# --- HuggingFace (опционально) ---
# Установи в 1 если модели уже скачаны и нет доступа в интернет
TRANSFORMERS_OFFLINE=0
HF_DATASETS_OFFLINE=0
